<resources>
    <style name="Theme.RfidHunter" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1B5E20</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#1B5E20</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.RfidHunter.TriggerWake" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
