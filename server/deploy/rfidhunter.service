[Unit]
Description=RFIDHunter backup API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=m
Group=m
WorkingDirectory=/home/m/rfidhunter-server
Environment=RFIDHUNTER_DATA_DIR=/home/m/rfidhunter-server/data
Environment=RFIDHUNTER_TOKEN_FILE=/home/m/rfidhunter-server/data/access_token
Environment=RFIDHUNTER_PASSWORD_PEPPER_FILE=/home/m/rfidhunter-server/data/password_pepper
ExecStart=/home/m/.local/bin/uv run --frozen --no-dev python -m rfidhunter_server --host 127.0.0.1 --port 18081
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
